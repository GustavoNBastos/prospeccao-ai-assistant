# Copie este arquivo para .env e preencha. NUNCA commite o .env.

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Observabilidade (Langfuse): cloud.langfuse.com > Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
